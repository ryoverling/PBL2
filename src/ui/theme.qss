/* ==========================================================================
   MONEYMANAGER DESIGN TOKENS (C++17 Qt 6 Widgets)
   Bang mau & Thong so he thong chuan PBL2 theo prompt goc:
   - Mau chinh (Primary):     #1E6FFF (hover: #155EEF, pressed: #0B43AB)
   - Mau Navy (Tieu de/Text): #0B2A6B (chu chinh, tieu de card, brand)
   - Mau chu phu (Muted):     #5B6B8C (chu phu, nhan mo ta, placeholder)
   - Khoan Thu (Income):      #0E8F4F / #19B26B (nen: #EAFBF3, border: #B7EBCE)
   - Khoan Chi (Expense):     #E0173D / #FF4D6A (nen: #FFF0F3, border: #FFCCD5)
   - The Vi Tien Mat:         #0E8F4F (nen pastel: #EAFBF3)
   - The Vi Ngan Hang:        #1E6FFF (nen pastel: #EBF3FE)
   - The Vi MoMo / Dien tu:   #8E3FD8 (nen pastel: #F0E3FF)
   - The Vi TPBank / Cam:     #FF9F1A (nen pastel: #FFF0D6)
   - Nen cua so & Content:    qlineargradient(#EAF2FF -> #F8FBFF)
   - Card container:          #FFFFFF (vien: #DCE8FA, bo goc: 18px)
   - Button & Input:          #FFFFFF (vien: #D5E1F5, bo goc: 12px, cao: 42px)
   - Chip / Badge:            bo goc dang pill (20px)
   - Bang du lieu:            Header #F1F6FF, hang cao 48px, hover #F8FAFD
   - ScrollBar token:         Nen trong suot, tay cam #CBD5E1 (hover #94A3B8)
   - Hover bang token:        Hang hover #F8FAFD, chon dong #E0EDFF (#1E6FFF)
   ========================================================================== */

/* 1. Reset & Global Typography */
QWidget {
    font-family: "Segoe UI", "Be Vietnam Pro", "Inter", sans-serif;
    font-size: 14px;
    color: #0B2A6B;
}

QMainWindow, #contentFrame, #DashboardPage, #TransactionPage, #WalletPage, #StatisticsPage, #SettingsPage {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #EAF2FF, stop:1 #F8FBFF);
}

QDialog {
    background-color: #FFFFFF;
}

/* 2. Tooltip Nen Tang */
QToolTip {
    background-color: #0B2A6B;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* 3. ScrollBar Mong Chuan Modern */
QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 4px 1px 4px 1px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 7px;
    margin: 1px 4px 1px 4px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0px;
}

/* 4. Checkbox Nen Tang */
QCheckBox {
    color: #0B2A6B;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #D5E1F5;
    border-radius: 5px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #1E6FFF;
}

QCheckBox::indicator:checked {
    background-color: #1E6FFF;
    border-color: #1E6FFF;
}

/* 5. Header Bar & Navigation */
#headerFrame {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #DCE8FA;
}

#lblAppTitle {
    color: #0B2A6B;
    font-size: 20px;
    font-weight: 700;
}

QPushButton[role="nav"] {
    background-color: transparent;
    border: none;
    font-size: 14px;
    font-weight: 500;
    color: #5B6B8C;
    padding: 0 12px;
    border-radius: 12px;
    min-height: 42px;
}

QPushButton[role="nav"]:hover {
    background-color: #F1F6FF;
    color: #0B2A6B;
}

QPushButton[role="nav"]:checked {
    background-color: #E0EDFF;
    color: #1E6FFF;
    font-weight: 700;
    border-radius: 12px;
}

/* 6. Login Window */
#LoginWindow {
    background-color: #FFFFFF;
}

#LoginWindow #frmWelcome {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #EAF2FF, stop:1 #DDEBFF);
    border-top-left-radius: 18px;
    border-bottom-left-radius: 18px;
    border-right: 1px solid #DCE8FA;
}

#LoginWindow #lblWelcomeBrand {
    color: #1E6FFF;
    font-size: 20px;
    font-weight: 700;
}

#LoginWindow #lblWelcomeHeadline {
    color: #0B2A6B;
    font-size: 22px;
    font-weight: 700;
}

#LoginWindow #lblWelcomeDescription {
    color: #5B6B8C;
    font-size: 13px;
}

#LoginWindow #lblWelcomeFooter {
    color: #94A3B8;
    font-size: 11px;
}

#LoginWindow #frmLogin {
    background-color: #FFFFFF;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
}

#LoginWindow #lblLoginHeading {
    color: #0B2A6B;
    font-size: 24px;
    font-weight: 700;
}

#LoginWindow #lblLoginDescription {
    color: #5B6B8C;
    font-size: 13px;
}

#LoginWindow #lblUsername, #LoginWindow #lblPassword {
    color: #0B2A6B;
    font-size: 13px;
    font-weight: 600;
}

#LoginWindow QLineEdit {
    min-height: 42px;
    border: 1px solid #D5E1F5;
    border-radius: 12px;
    padding-left: 10px;
    background-color: #FFFFFF;
    font-size: 13px;
    color: #0B2A6B;
}

#LoginWindow QLineEdit:focus {
    border: 1.5px solid #1E6FFF;
    background-color: #FFFFFF;
}

#LoginWindow #lblError, #RegisterDialog #lblError {
    color: #E0173D;
    font-size: 12px;
}

#LoginWindow #btnLogin {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E6FFF, stop:1 #155EEF);
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    border-radius: 12px;
    min-height: 44px;
    border: none;
}

#LoginWindow #btnLogin:hover {
    background: #155EEF;
}

#LoginWindow #btnRegister {
    background-color: #F1F6FF;
    border: 1px solid #D5E1F5;
    color: #1E6FFF;
    font-size: 13px;
    font-weight: 600;
    border-radius: 12px;
    min-height: 40px;
}

#LoginWindow #btnRegister:hover {
    background-color: #E0EDFF;
    border-color: #1E6FFF;
}

/* 7. Typography Headings */
QLabel#lblPageTitle, QLabel#lblDialogTitle {
    color: #0B2A6B;
    font-size: 26px;
    font-weight: 700;
}

QLabel#lblPageSubtitle {
    color: #5B6B8C;
    font-size: 14px;
}

/* 8. Cards & Containers (Bo goc 18px) */
QFrame[property="card"], #frmFilter, #frmChart, #frmDonut, #frmCalendarCard, #frmTableCard,
#cardAccount, #cardUtilities, #cardChangePassword {
    background-color: #FFFFFF;
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

QLabel[property="card-title"] {
    color: #5B6B8C;
    font-size: 14px;
    font-weight: 600;
}

/* 9. Financial KPIs */
QLabel[property="amount-income"], #lblFilteredIncome, #lblTotalIncome, #lblDayIncome {
    color: #0E8F4F;
    font-size: 26px;
    font-weight: 700;
}

QLabel[property="amount-expense"], #lblFilteredExpense, #lblTotalExpense, #lblDayExpense {
    color: #E0173D;
    font-size: 26px;
    font-weight: 700;
}

QLabel[property="amount-balance"], #lblTotalBalance, #lblNetTotal, #lblDayNet {
    color: #1E6FFF;
    font-size: 26px;
    font-weight: 700;
}

#cardBalance {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.65 #FFFFFF, stop:1 #EBF3FE);
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

#cardIncome {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.65 #FFFFFF, stop:1 #EAFBF3);
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

#cardExpense {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.65 #FFFFFF, stop:1 #FFF0F3);
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

#cardNet {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.65 #FFFFFF, stop:1 #EBF3FE);
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

#cardNet[netState="positive"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.65 #FFFFFF, stop:1 #EAFBF3);
    border: 1px solid #DCE8FA;
}

#cardNet[netState="positive"] #lblNetTotal {
    color: #0E8F4F;
}

#cardNet[netState="negative"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.65 #FFFFFF, stop:1 #FFF0F3);
    border: 1px solid #DCE8FA;
}

#cardNet[netState="negative"] #lblNetTotal {
    color: #E0173D;
}

#cardNet[netState="zero"] #lblNetTotal {
    color: #F59E0B;
}

#cardBalance {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #EBF3FF, stop:1 #FFFFFF);
    border: 1px solid #CFE2FF;
    border-radius: 18px;
}

#cardFilteredIncome {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.60 #FFFFFF, stop:1 #EAFBF3);
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

#cardFilteredExpense {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.60 #FFFFFF, stop:1 #FFF0F3);
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

#cardFilteredCount {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.60 #FFFFFF, stop:1 #EBF3FF);
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

#lblFilteredCount {
    color: #1E6FFF;
    font-size: 24px;
    font-weight: 700;
}

/* 10. Buttons Variants (Bo goc 12px, cao 42px) */
QPushButton {
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid #D5E1F5;
    border-radius: 12px;
    background-color: #FFFFFF;
    color: #0B2A6B;
    font-size: 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F8FAFD;
    border-color: #BACFE8;
}

QPushButton:pressed {
    background-color: #EEF4FC;
}

QPushButton:focus {
    border-color: #1E6FFF;
}

/* Primary Button */
QPushButton[role="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E6FFF, stop:1 #155EEF);
    border: 1px solid #1E6FFF;
    color: #FFFFFF;
    font-weight: 600;
    border-radius: 12px;
    padding: 0 20px;
}

QPushButton[role="primary"]:hover {
    background: #155EEF;
    border-color: #155EEF;
}

QPushButton[role="primary"]:pressed {
    background: #0B43AB;
    border-color: #0B43AB;
}

/* Secondary Button */
QPushButton[role="secondary"] {
    background-color: #FFFFFF;
    border: 1.5px solid #D5E1F5;
    color: #0B2A6B;
    font-weight: 600;
    border-radius: 12px;
    padding: 0 18px;
}

QPushButton[role="secondary"]:hover {
    background-color: #F8FAFD;
    border-color: #BACFE8;
}

QPushButton[role="secondary"]:pressed {
    background-color: #EEF4FC;
}

/* Danger Button */
QPushButton[role="danger"] {
    background-color: #FFFFFF;
    border: 1.5px solid #FFCCD5;
    color: #E0173D;
    font-weight: 600;
    border-radius: 12px;
    padding: 0 18px;
}

QPushButton[role="danger"]:hover {
    background-color: #FFF0F3;
    border-color: #E0173D;
}

QPushButton[role="danger"]:pressed {
    background-color: #FFE2E6;
}

/* Ghost Button */
QPushButton[role="ghost"] {
    background-color: transparent;
    border: none;
    color: #1E6FFF;
    font-weight: 600;
    padding: 0 12px;
    border-radius: 10px;
}

QPushButton[role="ghost"]:hover {
    background-color: #E0EDFF;
    color: #155EEF;
}

/* Filter Chip Buttons (Pill bo goc 20px) */
QPushButton[role="chip"] {
    background-color: #FFFFFF;
    border: 1px solid #D5E1F5;
    color: #5B6B8C;
    font-size: 13px;
    font-weight: 500;
    padding: 0 16px;
    min-height: 36px;
    border-radius: 18px;
}

QPushButton[role="chip"]:hover {
    background-color: #F8FAFD;
    color: #1E6FFF;
    border-color: #BACFE8;
}

QPushButton[role="chip"]:checked {
    background-color: #1E6FFF;
    border: 1px solid #1E6FFF;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton[role="reset"] {
    background-color: #FFFFFF;
    border: 1.5px solid #1E6FFF;
    color: #1E6FFF;
    font-size: 13px;
    font-weight: 600;
    border-radius: 12px;
    padding: 0 14px;
    min-height: 36px;
}

QPushButton[role="reset"]:hover {
    background-color: #E0EDFF;
    border-color: #155EEF;
}

QPushButton[role="reset"]:pressed {
    background-color: #CFE2FF;
}

QPushButton:disabled {
    background-color: #F8FAFD;
    border: 1px solid #D5E1F5;
    color: #94A3B8;
}

/* 11. Form Inputs & Combobox (Bo goc 12px, cao 42px) */
QLineEdit, QComboBox, QDateEdit, QSpinBox {
    min-height: 42px;
    background-color: #FFFFFF;
    border: 1px solid #D5E1F5;
    border-radius: 12px;
    padding: 2px 12px;
    color: #0B2A6B;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 1.5px solid #1E6FFF;
}

QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled, QSpinBox:disabled {
    background-color: #F8FAFD;
    border: 1px solid #D5E1F5;
    color: #94A3B8;
}

QComboBox {
    padding-right: 30px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DCE8FA;
    border-radius: 12px;
    padding: 6px;
    selection-background-color: #E0EDFF;
    selection-color: #1E6FFF;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 36px;
    padding: 6px 10px;
    border-radius: 8px;
    color: #0B2A6B;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #F8FAFD;
}

QDateEdit::drop-down {
    border: none;
    width: 26px;
    min-width: 26px;
}

QDateEdit {
    padding-right: 28px;
    min-width: 125px;
}

QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    background: transparent;
    width: 18px;
}

/* 12. Bang Du Lieu (Header #F1F6FF, Row cao 48px) */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #DCE8FA;
    border-radius: 14px;
    gridline-color: #F1F6FF;
    selection-background-color: #E0EDFF;
    selection-color: #1E6FFF;
}

QTableWidget#tblRecentTransactions, #frmTableCard QTableWidget {
    background-color: #FFFFFF;
    border: none;
    border-radius: 18px;
    gridline-color: transparent;
}

QPushButton#btnViewAll {
    border: 1.2px solid #1E6FFF;
    color: #1E6FFF;
    background-color: transparent;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    padding: 3px 12px;
    min-height: 28px;
}

QPushButton#btnViewAll:hover {
    background-color: #E0EDFF;
}

QTableWidget::item {
    min-height: 48px;
    padding: 8px 12px;
    border-bottom: 1px solid #F1F6FF;
    color: #0B2A6B;
}

QTableWidget::item:selected {
    background-color: #E0EDFF;
    color: #1E6FFF;
}

QTableWidget::item:hover {
    background-color: #F8FAFD;
}

QHeaderView::section {
    background-color: #F1F6FF;
    color: #5B6B8C;
    border: none;
    border-bottom: 1px solid #DCE8FA;
    padding: 12px;
    font-weight: 600;
    font-size: 13px;
    min-height: 40px;
}

/* 13. Calendar Widget & Popups */
QCalendarWidget QWidget {
    background-color: #FFFFFF;
    color: #0B2A6B;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #0B2A6B;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 4px;
}

QCalendarWidget QToolButton:hover {
    background-color: #E0EDFF;
    color: #1E6FFF;
}

QCalendarWidget QTableView {
    background-color: #FFFFFF;
    selection-background-color: #1E6FFF;
    selection-color: #FFFFFF;
    gridline-color: #F1F6FF;
    outline: 0;
}

QCalendarWidget QTableView::item:hover {
    background-color: #E0EDFF;
    color: #1E6FFF;
}

QCalendarWidget #qt_calendar_navigationbar {
    background-color: #F1F6FF;
    border-bottom: 1px solid #DCE8FA;
    padding: 4px;
}

/* 14. Wallet Cards */
QFrame#WalletCard {
    border: 1px solid #DCE8FA;
    border-radius: 18px;
    background-color: #FFFFFF;
}

QFrame#WalletCard[walletType="cash"] {
    border-top: 4px solid #0E8F4F;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.75 #FFFFFF, stop:1 #EAFBF3);
}

QFrame#WalletCard[walletType="bank"] {
    border-top: 4px solid #1E6FFF;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.75 #FFFFFF, stop:1 #EBF3FE);
}

QFrame#WalletCard[walletType="ewallet"] {
    border-top: 4px solid #8E3FD8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.75 #FFFFFF, stop:1 #F0E3FF);
}

QFrame#WalletCard[walletType="tpbank"] {
    border-top: 4px solid #FF9F1A;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.75 #FFFFFF, stop:1 #FFF0D6);
}

QFrame#WalletCard:hover {
    border-color: #BACFE8;
}

QFrame#WalletCard[selected="true"] {
    border: 2px solid #1E6FFF;
}

#WalletCard #lblName {
    color: #0B2A6B;
    font-size: 16px;
    font-weight: 700;
}

#WalletCard #lblType {
    color: #1E6FFF;
    background: #E0EDFF;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
}

#WalletCard #lblType[walletType="cash"] {
    color: #0E8F4F;
    background: #E6FAF3;
}

#WalletCard #lblType[walletType="ewallet"] {
    color: #8E3FD8;
    background: #F0E3FF;
}

#WalletCard #lblType[walletType="tpbank"] {
    color: #FF9F1A;
    background: #FFF4E6;
}

#WalletCard #lblBalanceCaption {
    color: #5B6B8C;
    font-size: 13px;
}

#WalletCard #lblBalance {
    color: #0B2A6B;
    font-size: 20px;
    font-weight: 700;
}

#WalletCard #lblBalance[negative="true"], #WalletCard #lblWarning {
    color: #E0173D;
}

#WalletCard #lblWarning {
    font-size: 12px;
}

#WalletPage #cardBalance {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.60 #FFFFFF, stop:1 #EAF2FF);
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

#WalletPage #lblBalanceTitle {
    color: #0B2A6B;
    font-size: 15px;
    font-weight: 700;
}

#WalletPage #lblTotalBalance {
    color: #1E6FFF;
    font-size: 40px;
    font-weight: 700;
}

#WalletPage #lblWalletCount {
    color: #5B6B8C;
    font-size: 13px;
}

#WalletPage #lblEyeCaption {
    color: #5B6B8C;
    font-size: 13px;
    font-weight: 500;
}
    font-size: 13px;
}

#WalletPage QPushButton#addWalletCard {
    min-height: 176px;
    max-height: 176px;
    padding: 0;
    border: 2px dashed #BACFE8;
    border-radius: 18px;
    background: transparent;
}

#WalletPage QPushButton#addWalletCard:hover {
    background-color: #E0EDFF;
    border-color: #1E6FFF;
}

/* 15. Statistics Page */
#StatisticsPage #scrollStatistics, #StatisticsPage #statisticsContent {
    background: transparent;
    border: none;
}

#StatisticsPage #cardIncome #lblTotalIncome,
#StatisticsPage #cardExpense #lblTotalExpense,
#StatisticsPage #cardNet #lblNetTotal {
    font-size: 25px;
}

#StatisticsPage #tblCategories {
    border: none;
    border-radius: 12px;
}

#StatisticsPage #tblCategories::item {
    border-bottom: 1px solid #F1F6FF;
    padding: 8px 10px;
    color: #0B2A6B;
}

#StatisticsPage #lblTopCategory, #StatisticsPage #lblComparison {
    color: #5B6B8C;
    font-size: 13px;
}

/* 16. Settings Page */
#scrollSettings, #settingsContent {
    background: transparent;
    border: none;
}

#cardAccount, #cardChangePassword, #cardUtilities {
    background-color: #FFFFFF;
    border: 1px solid #DCE8FA;
    border-radius: 18px;
}

#lblAccountHeading, #lblPasswordHeading, #lblSessionHeading {
    color: #0B2A6B;
    font-size: 16px;
    font-weight: 600;
}

#lblAccountAvatar {
    background-color: #E0EDFF;
    border-radius: 16px;
    color: #1E6FFF;
    font-size: 22px;
    font-weight: 700;
}

#lblCurrentAccount {
    color: #0B2A6B;
    font-size: 20px;
    font-weight: 700;
}

#lblAccountCaption, #lblSessionDescription,
#lblPasswordDescription {
    color: #5B6B8C;
    font-size: 14px;
}

#lblOldPassword, #lblNewPassword,
#lblConfirmPassword {
    color: #0B2A6B;
    font-size: 14px;
    font-weight: 600;
}

#cardChangePassword QLineEdit {
    min-height: 42px;
    border-radius: 12px;
    padding: 0 12px;
}

#btnChangePassword {
    min-height: 44px;
    border-radius: 12px;
    font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E6FFF, stop:1 #155EEF);
    color: #FFFFFF;
    border: none;
}

#SettingsPage #btnChangePassword:hover {
    background: #155EEF;
}

#SettingsPage #btnLogout {
    min-height: 44px;
    border-radius: 12px;
    font-weight: 600;
    background-color: #FFFFFF;
    border: 1.5px solid #FFCCD5;
    color: #E0173D;
}

#SettingsPage #btnLogout:hover {
    background-color: #FFF0F3;
    border-color: #E0173D;
}

/* 17. DatePickerField Styling */
DatePickerField {
    min-height: 42px;
    padding: 0 34px 0 12px;
    border: 1px solid #D5E1F5;
    border-radius: 12px;
    background-color: #FFFFFF;
    color: #0B2A6B;
    font-size: 13px;
    font-weight: 500;
}

DatePickerField:focus {
    border: 1.5px solid #1E6FFF;
}

DatePickerField:disabled {
    background-color: #F8FAFD;
    color: #94A3B8;
    border: 1px solid #D5E1F5;
}

/* 18. DatePickerPopup Styling */
DatePickerPopup {
    background-color: #FFFFFF;
    border: 1px solid #BACFE8;
    border-radius: 16px;
}

DatePickerPopup QPushButton {
    padding: 0;
    min-height: 38px;
    border-radius: 10px;
}

/* 19. Progress Bar Styling (Bo goc 6px, cao 12px) */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 6px;
    min-height: 12px;
    max-height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #1E6FFF;
    border-radius: 6px;
}

QProgressBar[variant="danger"]::chunk {
    background-color: #E0173D;
}

QProgressBar[variant="warning"]::chunk {
    background-color: #FF9F1A;
}

QProgressBar[variant="success"]::chunk {
    background-color: #0E8F4F;
}

/* PlanDialog Styles */
#lblPlanDialogTitle {
    font-size: 16px;
    font-weight: 700;
    color: #0B2A6B;
}

QGroupBox#grpBudget, QGroupBox#grpGoal {
    font-weight: 600;
    color: #0B2A6B;
    border: 1px solid #DCE8FA;
    border-radius: 12px;
    margin-top: 10px;
    padding-top: 14px;
    background: #FFFFFF;
}

QPushButton[role="danger-outline"] {
    color: #E0173D;
    background-color: #FFFFFF;
    border: 1.5px solid #FFCCD5;
    border-radius: 10px;
    padding: 0 14px;
    font-weight: 600;
    font-size: 13px;
}
QPushButton[role="danger-outline"]:hover {
    background-color: #FFF0F3;
}

/* EyeButton Styles */
EyeButton {
    border: none;
    background: transparent;
}

/* MonthPickerWidget Styles */
MonthPickerWidget QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #DCE6F2;
    border-radius: 8px;
    padding: 0;
}
MonthPickerWidget QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}
MonthPickerWidget QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #DCE6F2;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #102748;
    padding: 0 28px 0 10px;
}
MonthPickerWidget QLineEdit:hover {
    border-color: #1E6FFF;
    background-color: #F8FAFC;
}

/* DatePickerPopup Header & Footer Styles */
DatePickerPopup #btnPrevMonth, DatePickerPopup #btnNextMonth {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 0;
}
DatePickerPopup #btnPrevMonth:hover, DatePickerPopup #btnNextMonth:hover {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
}
DatePickerPopup #btnTitle {
    font-size: 16px;
    font-weight: 700;
    color: #102748;
    background: transparent;
    border: none;
    padding: 4px 10px;
    border-radius: 8px;
}
DatePickerPopup #btnTitle:hover {
    background-color: #F1F5F9;
}
DatePickerPopup #btnToday {
    font-size: 13px;
    font-weight: 600;
    padding: 0 16px;
    color: #1E6FFF;
    background-color: #FFFFFF;
    border: 1.5px solid #D5E1F5;
    border-radius: 10px;
}
DatePickerPopup #btnToday:hover {
    background-color: #EBF3FE;
    border-color: #1E6FFF;
}
DatePickerPopup #btnPopupCancel {
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
    border-radius: 10px;
    color: #5B6B8C;
    border: 1.5px solid #D5E1F5;
    background-color: #FFFFFF;
}
DatePickerPopup #btnPopupCancel:hover {
    background-color: #F1F6FF;
    color: #0B2A6B;
}
DatePickerPopup #btnPopupSelect {
    font-size: 13px;
    font-weight: 700;
    padding: 0 20px;
    border-radius: 10px;
    color: #FFFFFF;
    background-color: #1E6FFF;
    border: none;
}
DatePickerPopup #btnPopupSelect:hover {
    background-color: #155EEF;
}

/* Segmented Buttons in TransactionDialog */
#btnTypeExpense[active="true"] {
    background-color: #EBF3FE;
    border: 2px solid #1E6FFF;
    color: #1E6FFF;
    font-weight: 700;
    border-radius: 12px;
    font-size: 14px;
    min-height: 44px;
}
#btnTypeExpense[active="false"] {
    background-color: #FFFFFF;
    border: 1.5px solid #D5E1F5;
    color: #5B6B8C;
    font-weight: 500;
    border-radius: 12px;
    font-size: 14px;
    min-height: 44px;
}
#btnTypeExpense[active="false"]:hover {
    background-color: #F1F6FF;
    border-color: #BACFE8;
}
#btnTypeIncome[active="true"] {
    background-color: #EAFBF3;
    border: 2px solid #0E8F4F;
    color: #0E8F4F;
    font-weight: 700;
    border-radius: 12px;
    font-size: 14px;
    min-height: 44px;
}
#btnTypeIncome[active="false"] {
    background-color: #FFFFFF;
    border: 1.5px solid #D5E1F5;
    color: #5B6B8C;
    font-weight: 500;
    border-radius: 12px;
    font-size: 14px;
    min-height: 44px;
}
#btnTypeIncome[active="false"]:hover {
    background-color: #F1F6FF;
    border-color: #BACFE8;
}

